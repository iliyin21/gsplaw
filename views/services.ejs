<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb"><a href="/">Beranda</a><span class="sep">/</span><span>Layanan</span></div>
    <div class="eyebrow">Bidang Layanan</div>
    <h1>Layanan Hukum yang Kami Tangani</h1>
    <p>Kami memberikan pendampingan hukum menyeluruh mulai dari konsultasi awal, negosiasi, mediasi, hingga litigasi di pengadilan.</p>
  </div>
</section>

<section class="services" style="border-top:none;">
  <div class="container-wide">
    <div class="service-grid reveal">
      <% services.forEach((s, i) => { %>
      <div class="service-card">
        <span class="service-num">0<%= i + 1 %></span>
        <div class="service-icon"><%- include('partials/icons', {icon: s.icon}) %></div>
        <h3><%= s.title %></h3>
        <p><%= s.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="about-split">
  <div class="container-wide">
    <div class="section-head center reveal">
      <div class="eyebrow center">Alur Layanan</div>
      <h2 class="section-title">Bagaimana Kami Menangani Perkara Anda</h2>
    </div>
    <div class="timeline-values reveal reveal-2">
      <div class="tv-item"><span>01</span><h4>Konsultasi Awal</h4><p>Diskusi permasalahan hukum Anda secara rahasia bersama tim kami, langsung maupun via WhatsApp.</p></div>
      <div class="tv-item"><span>02</span><h4>Kajian &amp; Strategi</h4><p>Kami menganalisis duduk perkara dan menyusun strategi hukum yang paling tepat.</p></div>
      <div class="tv-item"><span>03</span><h4>Pendampingan</h4><p>Advokat kami mendampingi setiap proses, baik negosiasi, mediasi, maupun persidangan.</p></div>
      <div class="tv-item"><span>04</span><h4>Penyelesaian</h4><p>Mengawal perkara hingga tuntas dengan hasil yang melindungi kepentingan Anda.</p></div>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <div class="eyebrow center" style="color:#fff;">Konsultasi Gratis</div>
    <h2>Sampaikan Permasalahan Hukum Anda Hari Ini</h2>
    <p>Semakin cepat ditangani, semakin besar peluang penyelesaian yang menguntungkan bagi Anda.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="btn btn-primary">Chat via WhatsApp</a>
      <a href="/kontak" class="btn btn-outline">Kirim Pesan</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
