<%- include('partials/header') %>

<section class="page-hero <%= settings.heroImage ? 'has-bg' : '' %>" <% if (settings.heroImage) { %>style="background-image:url('<%= settings.heroImage %>');"<% } %>>
  <% if (settings.heroImage) { %><div class="hero-overlay"></div><% } %>
  <div class="container">
    <div class="breadcrumb"><a href="/">Beranda</a><span class="sep">/</span><span>Tentang Kami</span></div>
    <div class="eyebrow">Tentang Kami</div>
    <h1>Kantor Hukum yang Berdiri di Atas Integritas</h1>
    <p><%= settings.officeName %> hadir untuk mendampingi setiap individu maupun badan usaha dalam menghadapi persoalan hukum dengan strategi yang tepat dan penuh dedikasi.</p>
    <% if (settings.heroImage) { %>
    <div class="hero-mobile-photo"><img src="<%= settings.heroImage %>" alt="Tim <%= settings.officeName %>"></div>
    <% } %>
  </div>
</section>

<section class="about-split" style="padding-top:90px;">
  <div class="container-wide">
    <div class="about-grid">
      <div class="about-media reveal">
        <div class="frame">
          <img src="/uploads/team/ganang-sukma-permana.jpeg" alt="Ganang Sukma Permana, S.H.">
        </div>
        <div class="badge"><strong><%= settings.totalCasesHandled %>+</strong><span>Perkara Ditangani</span></div>
      </div>
      <div class="about-copy reveal reveal-2">
        <div class="eyebrow">Profil Firma</div>
        <h2 class="section-title">Siapa Kami</h2>
        <p><%= settings.aboutText %></p>
      </div>
    </div>

    <div class="vision-mission reveal">
      <div class="vm-card">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></div>
        <h3>Visi</h3>
        <p><%= settings.visionText %></p>
      </div>
      <div class="vm-card">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2z"/></svg></div>
        <h3>Misi</h3>
        <p><%= settings.missionText %></p>
      </div>
    </div>

    <div class="timeline-values reveal">
      <div class="tv-item"><span>01</span><h4>Integritas</h4><p>Menjunjung kejujuran dan etika profesi advokat dalam setiap langkah penanganan perkara.</p></div>
      <div class="tv-item"><span>02</span><h4>Profesionalisme</h4><p>Bekerja dengan standar hukum tertinggi dan riset yang mendalam pada setiap kasus.</p></div>
      <div class="tv-item"><span>03</span><h4>Kerahasiaan</h4><p>Menjaga kepercayaan klien dengan kerahasiaan penuh atas setiap informasi yang diberikan.</p></div>
      <div class="tv-item"><span>04</span><h4>Berorientasi Hasil</h4><p>Berupaya memberikan hasil terbaik yang melindungi hak dan kepentingan klien.</p></div>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <div class="eyebrow center" style="color:#fff;">Mari Berdiskusi</div>
    <h2>Percayakan Perkara Hukum Anda Kepada Kami</h2>
    <p>Tim kami siap memberikan konsultasi awal untuk memahami permasalahan hukum yang Anda hadapi.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a href="/kontak" class="btn btn-primary">Konsultasi Sekarang</a>
      <a href="/tim-kami" class="btn btn-outline">Kenali Tim Kami</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
