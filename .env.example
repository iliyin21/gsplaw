# Salin file ini menjadi ".env" lalu sesuaikan nilainya sebelum menjalankan server.
# WAJIB diisi dengan benar -- server tidak akan menyala tanpa koneksi database yang valid.

# Port server berjalan
PORT=3000

# Kunci rahasia untuk session login admin -- ganti dengan teks acak yang panjang
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang-dan-unik

# ---- Kredensial Database MySQL (WAJIB) ----
# Dapatkan dari hPanel Hostinger (Databases > MySQL Databases), Railway (klik plugin MySQL > Variables),
# atau dari instalasi MySQL/MariaDB lokal Anda sendiri kalau menjalankan di komputer.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gsp_lawfirm

# Akun admin default yang dibuat otomatis saat database masih kosong
# (hanya berlaku pada saat pertama kali server dijalankan)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=gsp@admin123
